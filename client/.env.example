# URL do backend Express
VITE_API_URL=http://localhost:4000

# Bearer token da API principal (Nest). Só é necessário quando o servidor roda
# com AUTH_REQUIRED=true. Enquanto o web não tiver login próprio, cole um token
# válido aqui — ou chame setAuthToken() de src/lib/api.ts em runtime.
# VITE_AUTH_TOKEN=
