generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// `id` é o próprio roomName do LiveKit (também usado como pasta de uploads).
// Gerado no servidor, opaco e não adivinhável — ver src/lib/roomName.ts.
//
// `atendimentoId` amarra a sala ao atendimento da API principal. É único, o
// que garante que a mesma consulta nunca ganhe duas salas e que o roomName
// seja imutável durante todo o ciclo de vida do atendimento.
model Room {
  id            String   @id
  atendimentoId String?  @unique
  createdAt     DateTime @default(now())
  files         UploadFile[]
}

model UploadFile {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id])
  storedName   String
  originalName String
  mimeType     String
  size         Int
  uploadedAt   DateTime @default(now())
}
