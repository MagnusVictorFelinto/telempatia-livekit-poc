generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// `id` é o próprio nome da sala (mesmo identificador usado no LiveKit e na
// pasta de uploads), simplificando o roteamento das APIs.
model Room {
  id        String   @id
  createdAt DateTime @default(now())
  files     UploadFile[]
}

model UploadFile {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id])
  storedName   String
  originalName String
  mimeType     String
  size         Int
  uploadedAt   DateTime @default(now())
}
