# Servidor Express
PORT=4000

# Credenciais do livekit-server (modo --dev usa devkey/secret por padrão)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# URL WebSocket do LiveKit devolvida aos clientes.
# ATENÇÃO: em dev com celular físico, `localhost` aponta para o próprio
# aparelho. Use o IP da LAN da máquina que roda o SFU, ex.:
#   LIVEKIT_URL=ws://192.168.0.10:7880
LIVEKIT_URL=ws://localhost:7880

# Endpoint HTTP do SFU usado pelo server SDK para criar salas.
# Se ficar vazio, é derivado do LIVEKIT_URL (ws:// -> http://).
# LIVEKIT_API_URL=http://localhost:7880

# Banco SQLite via Prisma
DATABASE_URL="file:./dev.db"

# Origens permitidas no CORS (lista separada por vírgula). Só afeta o cliente
# web — o app mobile faz requisição nativa e ignora CORS.
CLIENT_ORIGIN=http://localhost:5173

# --- Autenticação -----------------------------------------------------------
# false em dev; DEVE ser true em qualquer ambiente com dado real de paciente.
AUTH_REQUIRED=false

# Endpoint da API principal (Nest) usado para validar o Bearer recebido.
# AUTH_VERIFY_URL=https://develop.api.telempatia.empatiamedica.com.br/auth/me

# Cache do resultado da validação, para não bater na API a cada request.
AUTH_CACHE_TTL_MS=60000
AUTH_TIMEOUT_MS=5000
