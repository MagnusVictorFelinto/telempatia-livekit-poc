# Servidor Express
PORT=4000

# Credenciais do livekit-server (modo --dev usa devkey/secret por padrão)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# URL do LiveKit exposta ao backend (mesma porta do docker-compose)
LIVEKIT_URL=ws://localhost:7880

# Banco SQLite via Prisma
DATABASE_URL="file:./dev.db"

# Origem permitida no CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
